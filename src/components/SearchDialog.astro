---
import { getCollection } from 'astro:content';
import { fromDescriptionOrBody } from '@/utils/excerpt';
import { getCanonicalYear } from '@/utils/postYear';

const recentPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 8)
  .map((post) => {
    const year = getCanonicalYear(post);
    const href = `/posts/${year}/${post.data.slug}`;
    const excerpt = fromDescriptionOrBody({
      description: post.data.description,
      body: post.body,
      maxLength: 86,
    });
    const parts = new Intl.DateTimeFormat('zh-CN', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      timeZone: 'Asia/Shanghai',
    }).formatToParts(post.data.date);
    const get = (type: string) => parts.find((part) => part.type === type)?.value ?? '';

    return {
      title: post.data.title,
      url: href,
      excerpt,
      date: `${get('year')}-${get('month')}-${get('day')}`,
      tag: post.data.tags?.[0] ?? '',
    };
  });

const seedJson = JSON.stringify(recentPosts).replace(/</g, '\\u003c');
---
<button class="search-btn" id="search-open" aria-label="搜索文章" title="搜索文章">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m16.5 16.5 4.2 4.2"></path>
  </svg>
</button>

<dialog class="search-dialog" id="search-dialog" aria-label="搜索">
  <div class="search-inner">
    <div class="search-header">
      <svg class="search-input-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m16.5 16.5 4.2 4.2"></path>
      </svg>
      <input
        class="search-input"
        id="search-input"
        type="search"
        placeholder="搜索文章、标签、代码片段..."
        autocomplete="off"
        autofocus
      />
      <kbd class="search-key">/</kbd>
      <button class="search-close" id="search-close" aria-label="关闭搜索">关闭</button>
    </div>
    <div class="search-results" id="search-results" role="list" aria-live="polite"></div>
    <p class="search-footer">也可以从 <a href="/archives">归档</a> 或 <a href="/tags">标签</a> 进入</p>
  </div>
  <script type="application/json" id="search-seed" set:html={seedJson}></script>
</dialog>

<script>
  let pagefind: any = null;
  let pagefindReady = false;
  let debounceTimer: ReturnType<typeof setTimeout>;

  type SearchItem = {
    title: string;
    url: string;
    excerpt?: string;
    date?: string;
    tag?: string;
  };

  function getSeed(): SearchItem[] {
    const el = document.getElementById('search-seed');
    if (!el?.textContent) return [];
    try {
      return JSON.parse(el.textContent) as SearchItem[];
    } catch {
      return [];
    }
  }

  function normalizeUrl(url: string) {
    return url.replace(/\/$/, '');
  }

  function resultRank(item: SearchItem) {
    const path = new URL(item.url, location.origin).pathname;
    if (path.startsWith('/posts/')) return 0;
    if (path.startsWith('/tags/')) return 1;
    if (path.startsWith('/archives')) return 2;
    return 3;
  }

  function escapeHtml(value = '') {
    return value.replace(/[&<>"']/g, (ch) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[ch]!));
  }

  async function loadPagefind() {
    if (pagefindReady) return true;
    try {
      const pagefindUrl = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ pagefindUrl);
      await pagefind.init();
      pagefindReady = true;
      return true;
    } catch {
      pagefind = null;
      pagefindReady = false;
      return false;
    }
  }

  function renderItems(results: HTMLElement, items: SearchItem[]) {
    if (!items.length) {
      results.innerHTML = '<p class="search-empty">没有找到相关文章</p>';
      return;
    }

    results.innerHTML = items.map((item) => `
      <a class="search-item" href="${escapeHtml(item.url)}" role="listitem">
        <span class="search-item-main">
          <span class="search-item-title">${escapeHtml(item.title)}</span>
          ${item.excerpt ? `<span class="search-item-excerpt">${escapeHtml(item.excerpt)}</span>` : ''}
        </span>
        <span class="search-item-meta">
          ${item.date ? `<time>${escapeHtml(item.date)}</time>` : ''}
          ${item.tag ? `<span class="search-item-tag">${escapeHtml(item.tag)}</span>` : ''}
        </span>
      </a>
    `).join('');
  }

  function localSearch(seed: SearchItem[], q: string) {
    const query = q.toLowerCase();
    return seed.filter((item) =>
      [item.title, item.excerpt, item.tag].some((value) => value?.toLowerCase().includes(query))
    );
  }

  function initSearch() {
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const results = document.getElementById('search-results') as HTMLDivElement | null;
    const openBtn = document.getElementById('search-open') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('search-close') as HTMLButtonElement | null;
    if (!dialog || !input || !results || !openBtn || !closeBtn) return;

    const seed = getSeed();
    const byUrl = new Map(seed.map((item) => [normalizeUrl(item.url), item]));

    function renderRecent() {
      renderItems(results!, seed.slice(0, 5));
    }

    function openDialog() {
      dialog!.showModal();
      input!.focus();
      renderRecent();
      loadPagefind();
    }

    function closeDialog() {
      dialog!.close();
      input!.value = '';
      renderRecent();
    }

    openBtn.addEventListener('click', openDialog);
    closeBtn.addEventListener('click', closeDialog);

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(async () => {
        const q = input!.value.trim();
        if (!q) {
          renderRecent();
          return;
        }

        if (!pagefindReady) {
          await loadPagefind();
        }

        if (!pagefindReady) {
          renderItems(results!, localSearch(seed, q));
          return;
        }

        const { results: hits } = await pagefind.search(q);
        const items = await Promise.all(hits.slice(0, 12).map(async (hit: any) => {
          const data = await hit.data();
          const meta = byUrl.get(normalizeUrl(data.url));
          return {
            title: data.meta?.title ?? meta?.title ?? '无标题',
            url: data.url,
            excerpt: data.excerpt?.replace(/<[^>]+>/g, '') ?? meta?.excerpt,
            date: meta?.date,
            tag: meta?.tag,
          };
        }));
        renderItems(results!, items.sort((a, b) => resultRank(a) - resultRank(b)).slice(0, 8));
      }, 160);
    });

    renderRecent();
  }

  document.addEventListener('keydown', (e) => {
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
    if (!dialog) return;
    const activeTag = document.activeElement?.tagName;
    if (e.key === '/' && !dialog.open && activeTag !== 'INPUT' && activeTag !== 'TEXTAREA') {
      e.preventDefault();
      dialog.showModal();
      (document.getElementById('search-input') as HTMLInputElement | null)?.focus();
      const results = document.getElementById('search-results');
      if (results) renderItems(results, getSeed().slice(0, 5));
      loadPagefind();
    }
    if (e.key === 'Escape' && dialog.open) {
      dialog.close();
    }
  });

  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>
