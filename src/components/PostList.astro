---
import type { CollectionEntry } from 'astro:content';
import { fromDescriptionOrBody } from '@/utils/excerpt';
import { getCanonicalYear } from '@/utils/postYear';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;

function formatDate(date: Date): string {
  const parts = new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    timeZone: 'Asia/Shanghai',
  }).formatToParts(date);
  const get = (type: string) => parts.find((part) => part.type === type)?.value ?? '';
  return `${get('year')}-${get('month')}-${get('day')}`;
}
---
<ul class="post-list">
  {posts.map((post) => {
    const year = getCanonicalYear(post);
    const href = `/posts/${year}/${post.data.slug}`;
    const excerpt = fromDescriptionOrBody({
      description: post.data.description,
      body: post.body,
      maxLength: 120,
    });
    return (
      <li class="post-item">
        <time class="post-date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <a href={href} class="post-link" aria-label={post.data.title}>
          <h2 class="post-title" transition:name={`title-${post.data.slug}`}>{post.data.title}</h2>
          {excerpt && <p class="post-excerpt">{excerpt}</p>}
          {post.data.tags?.length > 0 && (
            <div class="post-tags" aria-label="文章标签">
              {post.data.tags.slice(0, 2).map((tag, index) => (
                <span class={`post-tag tone-${index % 2}`}>{tag}</span>
              ))}
            </div>
          )}
        </a>
      </li>
    );
  })}
</ul>
