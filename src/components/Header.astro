---
import { SITE } from '@/config/site';
import ThemeToggle from './ThemeToggle.astro';
import SearchDialog from './SearchDialog.astro';

const pathname = Astro.url.pathname;
const isActive = (prefix: string) =>
  prefix === '/' ? pathname === '/' || pathname.startsWith('/page/') : pathname.startsWith(prefix);

const links = [
  { href: '/', label: '文章' },
  { href: '/archives', label: '归档' },
  { href: '/tags', label: '标签' },
  { href: '/about', label: '关于' },
];
---
<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="site-title" aria-label={`${SITE.name} 首页`}>
      <span>{SITE.name}</span>
      <span class="site-title-separator">/</span>
      <span class="site-title-roman">{SITE.romanName}</span>
    </a>
    <ul class="nav-links">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class={isActive(href) ? 'active' : ''}>{label}</a>
        </li>
      ))}
    </ul>
    <span class="nav-divider" aria-hidden="true"></span>
    <SearchDialog />
    <ThemeToggle />
  </nav>
</header>
