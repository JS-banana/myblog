---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { getCanonicalYear } from '@/utils/postYear';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

type Post = (typeof sortedPosts)[0];
type MonthGroup = { monthKey: string; label: string; posts: Post[] };
type YearGroup = { year: number; months: MonthGroup[]; total: number };

const yearMap = new Map<number, Map<string, Post[]>>();

for (const post of sortedPosts) {
  const year = getCanonicalYear(post);
  const month = post.data.date.getMonth() + 1;
  const monthKey = `${year}-${String(month).padStart(2, '0')}`;

  if (!yearMap.has(year)) yearMap.set(year, new Map());
  const monthMap = yearMap.get(year)!;
  if (!monthMap.has(monthKey)) monthMap.set(monthKey, []);
  monthMap.get(monthKey)!.push(post);
}

const groups: YearGroup[] = Array.from(yearMap.entries())
  .sort((a, b) => b[0] - a[0])
  .map(([year, monthMap]) => {
    const months: MonthGroup[] = Array.from(monthMap.entries())
      .sort((a, b) => b[0].localeCompare(a[0]))
      .map(([monthKey, posts]) => {
        const [, m] = monthKey.split('-');
        return { monthKey, label: `${parseInt(m)} 月`, posts };
      });
    return { year, months, total: months.reduce((sum, month) => sum + month.posts.length, 0) };
  });

function formatDate(date: Date): string {
  const parts = new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    timeZone: 'Asia/Shanghai',
  }).formatToParts(date);
  const get = (type: string) => parts.find((part) => part.type === type)?.value ?? '';
  return `${get('year')}-${get('month')}-${get('day')}`;
}
---
<BaseLayout title="归档" description={`按年份查看 ${SITE.name} 的文章归档`}>
  <section class="page-hero archive-hero">
    <div class="page-title-row">
      <h1>归档</h1>
      <p>共 {sortedPosts.length} 篇文章</p>
    </div>
    <a class="page-top-link" href="/">回到最新文章</a>
  </section>

  <div class="archives-mobile-nav">
    <select id="year-jump" aria-label="跳转到年份">
      {groups.map((group) => <option value={`#year-${group.year}`}>{group.year} 年</option>)}
    </select>
  </div>

  <div class="archives-layout">
    <nav class="archives-sidebar" aria-label="年份导航">
      <ul>
        {groups.map(({ year, total }, index) => (
          <li>
            <a href={`#year-${year}`} class={index === 0 ? 'sidebar-year-link active' : 'sidebar-year-link'}>
              <span>{year}</span>
              <span class="sidebar-dot" aria-hidden="true"></span>
              <span class="sidebar-count">{total}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section class="archives-main">
      {groups.map(({ year, months, total }) => (
        <section class="archive-year-group" id={`year-${year}`}>
          <h2 class="archive-year-heading">
            <a href={`#year-${year}`} class="archive-year-anchor">{year}</a>
            <span class="archive-year-count">({total} 篇)</span>
          </h2>
          <div class="archive-table">
            {months.map(({ label, posts }) => (
              posts.map((post, index) => {
                const postYear = getCanonicalYear(post);
                const href = `/posts/${postYear}/${post.data.slug}`;
                return (
                  <a class="archive-row" href={href}>
                    <span class="archive-month">{index === 0 ? label : ''}</span>
                    <span class="archive-month-count">{index === 0 ? `${posts.length} 篇` : ''}</span>
                    <span class="archive-link">{post.data.title}</span>
                    <time class="archive-date" datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                  </a>
                );
              })
            ))}
          </div>
        </section>
      ))}
    </section>
  </div>
</BaseLayout>

<script>
  const select = document.getElementById('year-jump') as HTMLSelectElement | null;
  select?.addEventListener('change', () => {
    document.querySelector(select.value)?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
