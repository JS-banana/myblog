---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fromDescriptionOrBody } from '@/utils/excerpt';
import { getCanonicalYear } from '@/utils/postYear';
import { getAllTags, tagToSlug } from '@/utils/tags';

const tags = await getAllTags();
const featured = tags[0];
const related = tags.slice(1, 4);

function formatDate(date: Date): string {
  const parts = new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    timeZone: 'Asia/Shanghai',
  }).formatToParts(date);
  const get = (type: string) => parts.find((part) => part.type === type)?.value ?? '';
  return `${get('year')}-${get('month')}-${get('day')}`;
}
---
<BaseLayout title="标签 · 所有主题">
  <section class="page-hero tags-hero">
    <div class="page-title-row">
      <h1>标签</h1>
      <p>按主题重新进入文章</p>
    </div>
    <a class="page-top-link" href="/tags">全部主题</a>
  </section>

  {tags.length === 0 ? (
    <p class="muted">暂无标签</p>
  ) : (
    <>
      <nav class="tag-cloud" aria-label="全部标签">
        {tags.map(({ tag, count }, index) => (
          <a href={`/tags/${tagToSlug(tag)}`} class={index === 0 ? 'tag-card active' : 'tag-card'}>
            <span>{tag}</span>
            <small>{count}</small>
          </a>
        ))}
      </nav>

      {featured && (
        <section class="tag-feature">
          <aside class="tag-feature-panel">
            <h2>{featured.tag}</h2>
            <p class="tag-feature-kicker">最近关注</p>
            <p>
              记录关于 {featured.tag} 的观察、实践和取舍，也保存一些反复会用到的判断。
            </p>

            {related.length > 0 && (
              <div class="tag-related">
                <h3>相关主题</h3>
                <ol>
                  {related.map(({ tag, count }) => (
                    <li>
                      <a href={`/tags/${tagToSlug(tag)}`}>
                        <span>{tag}</span>
                        <small>{count} 篇</small>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </aside>

          <div class="tag-feature-posts">
            <p class="tag-feature-count">共 {featured.count} 篇文章</p>
            {featured.posts.slice(0, 3).map((post) => {
              const year = getCanonicalYear(post);
              const href = `/posts/${year}/${post.data.slug}`;
              const excerpt = fromDescriptionOrBody({
                description: post.data.description,
                body: post.body,
                maxLength: 84,
              });
              return (
                <a class="tag-post-row" href={href}>
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  <span>
                    <strong>{post.data.title}</strong>
                    {excerpt && <em>{excerpt}</em>}
                  </span>
                </a>
              );
            })}
            <a class="tag-all-link" href={`/tags/${tagToSlug(featured.tag)}`}>查看该标签下的全部文章</a>
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>
